{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "bin/**/*"],
  "exclude": ["node_modules", "dist", "build", ".hutch"]
}
